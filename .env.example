# ---------------------------------------------------------------
# ReadyStock - ตัวอย่างไฟล์ตั้งค่า
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้เรียบร้อยก่อนรันงานจริง
#   cp .env.example .env
# ---------------------------------------------------------------

# พอร์ตที่แอปจะฟัง (ผูกกับ localhost เท่านั้น แล้วให้ nginx reverse proxy เข้ามา)
PORT=3300

# คีย์ลับสำหรับเซ็น session cookie
# ต้องเปลี่ยนเป็นค่าสุ่มยาว ๆ ของตัวเอง สร้างได้ด้วยคำสั่ง:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=เปลี่ยนค่านี้เป็นข้อความสุ่มยาวๆ

# หมายเหตุ: ไม่มีตัวแปร INVITE_CODE แล้ว
# เดิมใช้รหัสเชิญรหัสเดียวคงที่ในไฟล์นี้ร่วมกันทุกคน
# ตอนนี้เปลี่ยนมาใช้ "รหัสเชิญแบบสุ่ม" ที่ผู้ดูแลระบบกดสร้างเองได้จากหน้า "จัดการระบบ" ในเว็บ
# โดยแต่ละรหัสใช้สมัครได้เพียงครั้งเดียวและหมดอายุใน 24 ชั่วโมง
# (ถ้ามีค่า INVITE_CODE ค้างอยู่ในไฟล์ .env เดิม จะไม่ถูกใช้งานแล้ว ลบทิ้งได้เลย)
#
# ผู้ใช้คนแรกของระบบสมัครได้เลยโดยไม่ต้องใช้รหัสเชิญ (เพราะยังไม่มีใครสร้างรหัสให้ได้)
# และจะได้สิทธิ์ admin โดยอัตโนมัติ

# โหมดการทำงาน production = ใช้งานจริง / development = ทดสอบบนเครื่อง
NODE_ENV=production

# ---------------------------------------------------------------
# ค่าต่อไปนี้ไม่จำเป็นต้องตั้ง มีค่าเริ่มต้นให้อยู่แล้ว
# ---------------------------------------------------------------

# ที่อยู่ไฟล์ฐานข้อมูล SQLite (ค่าเริ่มต้น: data/readystock.sqlite)
# DB_FILE=data/readystock.sqlite

# ส่ง cookie เฉพาะผ่าน HTTPS หรือไม่
# ค่าเริ่มต้น: true เมื่อ NODE_ENV=production, false เมื่อทดสอบบนเครื่อง
# ถ้าเปิดเว็บผ่าน http:// ธรรมดาแล้ว login ไม่ติด ให้ตั้งเป็น false
# COOKIE_SECURE=true

# จำนวนสินค้าต่อหน้า (ค่าเริ่มต้น 50)
# PAGE_SIZE=50

# จำนวนครั้งที่กรอกรหัสผิดได้ก่อนโดนล็อก (ค่าเริ่มต้น 5) และเวลาล็อกเป็นนาที (ค่าเริ่มต้น 15)
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15
