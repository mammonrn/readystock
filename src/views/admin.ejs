<%- include('partials/header') %>

<div class="page-head">
  <h1>จัดการระบบ</h1>
  <span class="muted">สำหรับผู้ดูแลระบบเท่านั้น</span>
</div>

<div class="admin-grid">
  <div class="card">
    <h2>สำนักงาน</h2>

    <form method="post" action="/admin/offices/create" class="row-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input name="name" placeholder="ชื่อสำนักงานใหม่" required maxlength="64">
      <button class="btn btn-primary btn-sm" type="submit">เพิ่ม</button>
    </form>

    <table class="table table-compact">
      <thead>
        <tr><th>ชื่อ</th><th class="num">สินค้า</th><th class="col-action">จัดการ</th></tr>
      </thead>
      <tbody>
        <% offices.forEach(function (row) { %>
          <tr>
            <td>
              <form method="post" action="/admin/offices/<%= row.id %>/rename" class="row-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input name="name" value="<%= row.name %>" required maxlength="64">
                <button class="btn btn-sm btn-secondary" type="submit">บันทึกชื่อ</button>
              </form>
            </td>
            <td class="num"><%= row.item_count.toLocaleString('th-TH') %></td>
            <td class="col-action">
              <% if (row.item_count > 0) { %>
                <span class="muted xsmall" title="ต้องย้ายหรือลบสินค้าออกก่อน">ลบไม่ได้ (มีสินค้าใช้อยู่)</span>
              <% } else { %>
                <form method="post" action="/admin/offices/<%= row.id %>/delete" class="inline"
                      data-confirm="ยืนยันการลบสำนักงาน &quot;<%= row.name %>&quot; ?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-sm btn-danger" type="submit">ลบ</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="card">
    <div class="card-head">
      <h2>หมวดหมู่</h2>
      <span class="muted small">
        ลากแถวเพื่อสลับลำดับ (หรือใช้ปุ่ม ↑ ↓) · ลำดับนี้มีผลกับดรอปดาวน์เลือกหมวดหมู่ทุกที่ ·
        รหัสนำหน้าใช้ออกรหัสสินค้า เช่น TLP0001
      </span>
    </div>

    <form method="post" action="/admin/categories/create" class="row-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input name="name" placeholder="ชื่อหมวดหมู่ใหม่" required maxlength="64">
      <input name="codePrefix" placeholder="รหัสนำหน้า (เว้นว่างได้)" maxlength="8" class="code-input prefix-input">
      <button class="btn btn-primary btn-sm" type="submit">เพิ่ม</button>
    </form>

    <form method="post" action="/admin/categories/reorder" id="category-order-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="order" id="category-order"
             value="<%= categories.map(function (c) { return c.id; }).join(',') %>">
      <table class="table table-compact" id="category-table" data-sortable>
        <thead>
          <tr>
            <th class="col-drag" title="ลากเพื่อสลับลำดับ">ลำดับ</th>
            <th>ชื่อ / รหัสนำหน้า</th>
            <th class="num">สินค้า</th>
            <th class="col-action">จัดการ</th>
          </tr>
        </thead>
        <tbody>
          <% categories.forEach(function (row, index) { %>
            <tr draggable="true" data-id="<%= row.id %>">
              <td class="col-drag">
                <span class="drag-handle" title="ลากเพื่อสลับลำดับ">⠿</span>
                <span class="order-number"><%= index + 1 %></span>
              </td>
              <td>
                <span class="row-form">
                  <input form="category-<%= row.id %>-form" name="name" value="<%= row.name %>" required maxlength="64">
                  <input form="category-<%= row.id %>-form" name="codePrefix" value="<%= row.code_prefix %>"
                         maxlength="8" class="code-input prefix-input" title="รหัสนำหน้าสำหรับออกรหัสสินค้า">
                  <button form="category-<%= row.id %>-form" class="btn btn-sm btn-secondary" type="submit">บันทึก</button>
                </span>
              </td>
              <td class="num"><%= row.item_count.toLocaleString('th-TH') %></td>
              <td class="col-action">
                <span class="move-buttons">
                  <button form="category-<%= row.id %>-up" class="btn btn-sm btn-ghost" type="submit"
                          title="เลื่อนขึ้น" <%= index === 0 ? 'disabled' : '' %>>↑</button>
                  <button form="category-<%= row.id %>-down" class="btn btn-sm btn-ghost" type="submit"
                          title="เลื่อนลง" <%= index === categories.length - 1 ? 'disabled' : '' %>>↓</button>
                </span>
                <% if (row.item_count > 0) { %>
                  <span class="muted xsmall" title="ต้องย้ายหรือลบสินค้าออกก่อน">ลบไม่ได้</span>
                <% } else { %>
                  <button form="category-<%= row.id %>-delete" class="btn btn-sm btn-danger" type="submit">ลบ</button>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <button class="btn btn-primary btn-sm" type="submit" id="save-category-order" hidden>บันทึกลำดับใหม่</button>
    </form>

    <%# ฟอร์มของแต่ละแถวต้องอยู่นอกตาราง เพราะ HTML ไม่อนุญาตให้ซ้อน form ในอีก form %>
    <% categories.forEach(function (row) { %>
      <form method="post" action="/admin/categories/<%= row.id %>/rename" id="category-<%= row.id %>-form" class="hidden-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      </form>
      <form method="post" action="/admin/categories/<%= row.id %>/move" id="category-<%= row.id %>-up" class="hidden-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="direction" value="up">
      </form>
      <form method="post" action="/admin/categories/<%= row.id %>/move" id="category-<%= row.id %>-down" class="hidden-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="direction" value="down">
      </form>
      <form method="post" action="/admin/categories/<%= row.id %>/delete" id="category-<%= row.id %>-delete" class="hidden-form"
            data-confirm="ยืนยันการลบหมวดหมู่ &quot;<%= row.name %>&quot; ?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      </form>
    <% }); %>
  </div>
</div>

<div class="card">
  <div class="card-head">
    <h2>รหัสเชิญ</h2>
    <span class="muted small">
      รหัสหนึ่งรหัสใช้สมัครได้ครั้งเดียว หมดอายุใน <%= inviteTtlHours %> ชั่วโมง ·
      ใช้ได้อยู่ตอนนี้ <strong><%= activeInviteCount.toLocaleString('th-TH') %></strong> รหัส
    </span>
  </div>

  <form method="post" action="/admin/invites/create" class="row-form invite-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="inviteCount" class="inline-label">จำนวนรหัสที่ต้องการ</label>
    <input id="inviteCount" name="count" type="number" min="1" max="<%= maxInvitePerBatch %>" value="1" required>
    <button class="btn btn-primary btn-sm" type="submit">สร้างรหัสเชิญ</button>
  </form>

  <table class="table table-compact">
    <thead>
      <tr>
        <th class="col-code">รหัส</th>
        <th>สถานะ</th>
        <th>หมดอายุ</th>
        <th>สร้างโดย</th>
        <th class="col-action">คัดลอก</th>
      </tr>
    </thead>
    <tbody>
      <% if (inviteCodes.length === 0) { %>
        <tr><td colspan="5" class="empty-row">ยังไม่มีรหัสเชิญ กดปุ่ม "สร้างรหัสเชิญ" ด้านบนเพื่อสร้าง</td></tr>
      <% } %>
      <% inviteCodes.forEach(function (invite) { %>
        <tr class="<%= invite.status === 'active' ? '' : 'row-dim' %>">
          <td class="col-code"><code class="invite-code"><%= invite.code %></code></td>
          <td>
            <% if (invite.status === 'active') { %>
              <span class="tag tag-success">ยังไม่ใช้</span>
            <% } else if (invite.status === 'used') { %>
              <span class="tag tag-info">ใช้แล้ว</span>
              <span class="muted xsmall">
                โดย <%= invite.used_by_name || 'ผู้ใช้ที่ถูกลบ' %> เมื่อ <%= thaiTime(invite.used_at) %>
              </span>
            <% } else { %>
              <span class="tag tag-muted">หมดอายุแล้ว</span>
            <% } %>
          </td>
          <td class="col-time"><%= thaiTime(invite.expires_at) %></td>
          <td class="muted xsmall"><%= invite.created_by_name || '-' %></td>
          <td class="col-action">
            <% if (invite.status === 'active') { %>
              <button type="button" class="btn btn-sm btn-secondary" data-copy="<%= invite.code %>">คัดลอก</button>
            <% } else { %>
              <span class="muted xsmall">—</span>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<div class="card">
  <h2>ผู้ใช้งาน</h2>
  <table class="table">
    <thead>
      <tr>
        <th>ชื่อผู้ใช้</th>
        <th>สิทธิ์</th>
        <th>สมัครเมื่อ</th>
        <th>ตั้งรหัสผ่านใหม่</th>
        <th class="col-action">จัดการ</th>
      </tr>
    </thead>
    <tbody>
      <% userList.forEach(function (u) { %>
        <tr>
          <td>
            <%= u.username %>
            <% if (u.id === currentUser.id) { %><span class="muted xsmall">(คุณ)</span><% } %>
          </td>
          <td><span class="badge <%= u.role %>"><%= u.role %></span></td>
          <td class="muted xsmall"><%= u.created_at %></td>
          <td>
            <form method="post" action="/admin/users/<%= u.id %>/reset-password" class="row-form"
                  data-confirm="ยืนยันตั้งรหัสผ่านใหม่ให้ <%= u.username %> ?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input name="password" type="text" minlength="6" required placeholder="รหัสผ่านใหม่ (6 ตัวขึ้นไป)">
              <button class="btn btn-sm btn-secondary" type="submit">ตั้งรหัสใหม่</button>
            </form>
          </td>
          <td class="col-action">
            <form method="post" action="/admin/users/<%= u.id %>/role" class="row-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <select name="role">
                <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>user</option>
                <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>admin</option>
              </select>
              <button class="btn btn-sm btn-secondary" type="submit">เปลี่ยนสิทธิ์</button>
            </form>
            <% if (u.id !== currentUser.id) { %>
              <form method="post" action="/admin/users/<%= u.id %>/delete" class="inline"
                    data-confirm="ยืนยันการลบผู้ใช้ <%= u.username %> ?&#10;การลบไม่สามารถย้อนกลับได้">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm btn-danger" type="submit">ลบผู้ใช้</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
